{
  "seed": 42,
  "data": {
    "data_path": "/root/Audio-Data/",
    "mdct_config": "shore_tts/configs/mdct.json",
    "num_workers": 16,
    "min_length": 480,
    "max_length": 6000,
    "batch_size": 16,
    "epoch_shuffle": true
  },
  "text": {
    "tokenizer_path": "checkpoints/vocab.json",
    "polyphone": true
  },
  "model": {
    "dit": {
      "dim": 768,
      "depth": 22,
      "heads": 12,
      "dim_head": 64,
      "dropout": 0.1,
      "ff_mult": 2,
      "text_dim": 512,
      "text_mask_padding": true,
      "text_embedding_average_upsampling": false,
      "qk_norm": null,
      "conv_layers": 4,
      "pe_attn_head": 1,
      "attn_backend": "torch",
      "attn_mask_enabled": true,
      "long_skip_connection": false,
      "checkpoint_activations": true
    },
    "cfm": {
      "sigma": 0.0,
      "audio_drop_prob": 0.3,
      "cond_drop_prob": 0.2,
      "frac_lengths_mask": [0.7, 1.0]
    },
    "fwd": {
      "init_channel": 32,
      "strides": [4, 4, 4],
      "kernel_size": 31
    }
  },
  "optim": {
    "optimizer_type": "muon_adamw",
    "lr": 1e-4,
    "weight_decay": 0.0,
    "betas": [0.9, 0.95],
    "fused": true
  },
  "disc_optim": {
    "optimizer_type": "muon_adamw",
    "lr": 5e-4,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "fused": true
  },
  "scheduler": {
    "warmup_steps": 5000,
    "warmup_start_factor": 0.01,
    "final_lr_scale": 0.01
  },
  "train": {
    "epochs": 1000,
    "max_steps": 100000,
    "grad_accumulation_steps": 1,
    "log_every_steps": 10,
    "timing_every_steps": 100,
    "save_every_steps": 10000,
    "last_per_updates": 2000,
    "keep_last_n_checkpoints": 20,
    "ema_decay": 0.9999,
    "precision": "fp16",
    "allow_tf32": false,
    "save_dir": "checkpoints/discriminator",
    "resume_from": "checkpoints/pretrain-200M/model_last.pt",
    "disc_resume_from": "checkpoints/discriminator/discriminator_last.pt",
    "ref_ratio": 0.3,
    "gen_steps": 16,
    "gen_cfg_strength": 1.0,
    "adv_loss_weight": 1.0,
    "fm_loss_weight": 1.0,
    "tensorboard": {
      "enabled": true,
      "log_dir": "checkpoints/discriminator/tensorboard"
    }
  }
}
